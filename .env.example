# ============================================================
#  Ollama Proxy — 环境变量配置示例
#  复制此文件为 .env，然后填入你的 API Keys
# ============================================================

# 服务端口（默认 11434，与 Ollama 保持一致）
PORT=11434

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否启用 CORS（允许跨域请求）
CORS_ENABLED=true

# 代理转发超时（毫秒）
REQUEST_TIMEOUT=120000

# ── API Keys ────────────────────────────────────────────────
# 留空表示使用配置文件 models.yaml 中对应的占位符
# 若在此处定义，会覆盖 models.yaml 中的 api_key

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
SILICON_API_KEY=
TOGETHER_API_KEY=

# ── Anthropic 额外配置 ───────────────────────────────────────
# Anthropic API 的版本，默认 claude-3-5-sonnet-20241022
ANTHROPIC_VERSION=2023-06-01

# ── Gemini 额外配置 ─────────────────────────────────────────
# Gemini 使用的 API 版本
GEMINI_VERSION=v1beta
