# ============================================================
#  Ollama Proxy — 环境变量配置
#  复制此文件为 .env，填入你的 API Keys
# ============================================================

# 服务端口（默认 11434）
PORT=11434

# ── 日志配置 ────────────────────────────────────────────────
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 日志目录（默认 ./logs）
LOG_DIR=./logs

# 日志文件名（默认 ollama-proxy.log）
LOG_FILE=ollama-proxy.log

# 单日志文件最大大小（字节，默认 10MB）
LOG_MAX_SIZE=10485760

# JSON 格式日志（适合容器环境）
LOG_JSON=false

# ── 服务配置 ────────────────────────────────────────────────
# 启用 CORS
CORS_ENABLED=true

# 请求超时（毫秒）
REQUEST_TIMEOUT=120000

# ── API Keys ─────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
SILICON_API_KEY=
TOGETHER_API_KEY=
MINIMAX_API_KEY=

# ── Provider 特殊配置 ────────────────────────────────────────
ANTHROPIC_VERSION=2023-06-01
GEMINI_VERSION=v1beta
